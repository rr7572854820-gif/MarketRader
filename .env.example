# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it. This file lists every environment variable the project
# is expected to need through the full MVP, even though Task 1-2 only use
# the Reddit and Gemini ones.

# --- Reddit (read-only, personal-use "script" app) — OPTIONAL ---
# Leave all three blank to run in mock mode: no Reddit account or API key
# needed, dummy sample posts are used instead of real Reddit data. Create
# these at https://www.reddit.com/prefs/apps whenever you're ready to
# switch to real data — see task notes for step-by-step instructions.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive user agent; include your Reddit username.
REDDIT_USER_AGENT=marketradar-personal-research-tool by u/YOUR_REDDIT_USERNAME

# --- Google Gemini (AI provider) ---
# Free tier available. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Which Gemini model the extractor/grouper steps use.
# Leave blank to use the project default (gemini-flash-latest — an
# alias Google keeps pointed at their current recommended fast model).
# Pin a specific dated model name here instead if you want reproducible
# behavior across time; check https://ai.google.dev/gemini-api/docs/models
# for what's currently available to your key (client.models.list() can
# show a model that's listed but still blocked for new-user generation —
# confirmed this the hard way, see SESSION.md).
GEMINI_MODEL=

# --- Groq (AI provider) — OPTIONAL ---
# If set, takes priority over Gemini (see get_ai_provider() in
# src/ai/__init__.py) - faster inference, higher free-tier limits.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional key rotation (recommended for higher effective throughput):
# set up to 3 keys and GroqProvider automatically rotates to the next
# one when the currently-active key hits Groq's rate limit (429) or is
# rejected (401) - see src/ai/groq_provider.py. Get free keys at
# https://console.groq.com/keys (a separate account/key each, since
# rotation only helps if each key has its own quota).
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
#
# If GROQ_API_KEY_1/2/3 are set, they take priority over the single
# GROQ_API_KEY above. GROQ_API_KEY alone (the original way) still works
# unchanged if you don't need rotation.

# --- GitHub (GitHubFetcher) — OPTIONAL ---
# Optional. Without it, the public API is used (60 req/hour limit).
# With it, the limit increases to 5000 req/hour.
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=