# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it. This file lists every environment variable the project
# is expected to need through the full MVP (see ROADMAP.md / architecture
# discussion), even though Task 1 only uses the Reddit and Anthropic ones.

# --- Reddit (read-only, personal-use "script" app) ---
# Create at https://www.reddit.com/prefs/apps — see README/task notes for
# step-by-step instructions on getting these three values.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive user agent; include your Reddit username.
REDDIT_USER_AGENT=marketradar-personal-research-tool by u/YOUR_REDDIT_USERNAME

# --- Anthropic (Claude) ---
# Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Which Claude model the extractor/grouper steps use.
# Leave blank to use the project default (claude-sonnet-5).
CLAUDE_MODEL=
